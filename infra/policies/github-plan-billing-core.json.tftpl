{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BillingBudgetRead",
      "Effect": "Allow",
      "Action": "budgets:ViewBudget",
      "Resource": "arn:aws:budgets::${account_id}:budget/attendance-project-monthly-cost"
    },
    {
      "Sid": "BillingAccountRead",
      "Effect": "Allow",
      "Action": "aws-portal:ViewBilling",
      "Resource": "*"
    },
    {
      "Sid": "CostAllocationTagRead",
      "Effect": "Allow",
      "Action": "ce:ListCostAllocationTags",
      "Resource": "*"
    }
  ]
}
