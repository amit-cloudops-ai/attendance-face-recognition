{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "SqsQueueCreate",
      "Effect": "Allow",
      "Action": "sqs:CreateQueue",
      "Resource": [
        "arn:aws:sqs:us-east-1:${account_id}:attendance-prod-recognize-dlq",
        "arn:aws:sqs:us-east-1:${account_id}:attendance-prod-enroll-dlq",
        "arn:aws:sqs:us-east-1:${account_id}:attendance-prod-failure-processor-dlq"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "attendance",
          "aws:RequestTag/Environment": "prod"
        }
      }
    },
    {
      "Sid": "CloudWatchLogGroups",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:PutRetentionPolicy",
        "logs:DeleteLogGroup",
        "logs:ListTagsForResource",
        "logs:TagResource",
        "logs:UntagResource"
      ],
      "Resource": [
        "arn:aws:logs:us-east-1:${account_id}:log-group:/aws/lambda/attendance-prod-*:*",
        "arn:aws:logs:us-east-1:${account_id}:log-group:/aws/apigateway/attendance-prod-http-api:*"
      ]
    },
    {
      "Sid": "CloudWatchLogGroupList",
      "Effect": "Allow",
      "Action": [
        "logs:DescribeLogGroups"
      ],
      "Resource": "*"
    },
    {
      "Sid": "CloudWatchAlarms",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:PutMetricAlarm",
        "cloudwatch:DescribeAlarms",
        "cloudwatch:DeleteAlarms"
      ],
      "Resource": "arn:aws:cloudwatch:us-east-1:${account_id}:alarm:attendance-prod-*"
    },
    {
      "Sid": "SchedulerGroup",
      "Effect": "Allow",
      "Action": [
        "scheduler:CreateScheduleGroup",
        "scheduler:GetScheduleGroup",
        "scheduler:DeleteScheduleGroup",
        "scheduler:TagResource",
        "scheduler:UntagResource",
        "scheduler:ListTagsForResource"
      ],
      "Resource": "arn:aws:scheduler:us-east-1:${account_id}:schedule-group/attendance-prod"
    },
    {
      "Sid": "SchedulerSchedules",
      "Effect": "Allow",
      "Action": [
        "scheduler:CreateSchedule",
        "scheduler:GetSchedule",
        "scheduler:UpdateSchedule",
        "scheduler:DeleteSchedule"
      ],
      "Resource": "arn:aws:scheduler:us-east-1:${account_id}:schedule/attendance-prod/attendance-prod-*"
    },
    {
      "Sid": "SqsQueues",
      "Effect": "Allow",
      "Action": [
        "sqs:GetQueueAttributes",
        "sqs:SetQueueAttributes",
        "sqs:DeleteQueue",
        "sqs:ListQueueTags",
        "sqs:TagQueue",
        "sqs:UntagQueue"
      ],
      "Resource": [
        "arn:aws:sqs:us-east-1:${account_id}:attendance-prod-recognize-dlq",
        "arn:aws:sqs:us-east-1:${account_id}:attendance-prod-enroll-dlq",
        "arn:aws:sqs:us-east-1:${account_id}:attendance-prod-failure-processor-dlq"
      ]
    },
    {
      "Sid": "RekognitionCollectionCreate",
      "Effect": "Allow",
      "Action": [
        "rekognition:CreateCollection"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "attendance",
          "aws:RequestTag/Environment": "prod"
        }
      }
    },
    {
      "Sid": "RekognitionCollectionManage",
      "Effect": "Allow",
      "Action": [
        "rekognition:DescribeCollection",
        "rekognition:DeleteCollection"
      ],
      "Resource": "arn:aws:rekognition:us-east-1:${account_id}:collection/attendance-prod-faces"
    },
    {
      "Sid": "S3RawBucketNotifications",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketNotification",
        "s3:PutBucketNotification"
      ],
      "Resource": "arn:aws:s3:::attendance-prod-${account_id}-raw"
    }
  ]
}
