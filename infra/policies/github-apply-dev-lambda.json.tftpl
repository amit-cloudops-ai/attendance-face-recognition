{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "LambdaLifecycle",
      "Effect": "Allow",
      "Action": [
        "lambda:CreateFunction",
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration",
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration",
        "lambda:DeleteFunction",
        "lambda:PublishVersion",
        "lambda:GetFunctionConcurrency",
        "lambda:PutFunctionConcurrency",
        "lambda:DeleteFunctionConcurrency",
        "lambda:ListTags",
        "lambda:TagResource",
        "lambda:UntagResource"
      ],
      "Resource": [
        "arn:aws:lambda:us-east-1:${account_id}:function:attendance-dev-employees",
        "arn:aws:lambda:us-east-1:${account_id}:function:attendance-dev-attendance-query",
        "arn:aws:lambda:us-east-1:${account_id}:function:attendance-dev-daily-job",
        "arn:aws:lambda:us-east-1:${account_id}:function:attendance-dev-weekly-job",
        "arn:aws:lambda:us-east-1:${account_id}:function:attendance-dev-reports",
        "arn:aws:lambda:us-east-1:${account_id}:function:attendance-dev-override",
        "arn:aws:lambda:us-east-1:${account_id}:function:attendance-dev-settings",
        "arn:aws:lambda:us-east-1:${account_id}:function:attendance-dev-presign",
        "arn:aws:lambda:us-east-1:${account_id}:function:attendance-dev-result",
        "arn:aws:lambda:us-east-1:${account_id}:function:attendance-dev-recognize",
        "arn:aws:lambda:us-east-1:${account_id}:function:attendance-dev-enroll",
        "arn:aws:lambda:us-east-1:${account_id}:function:attendance-dev-enroll-url",
        "arn:aws:lambda:us-east-1:${account_id}:function:attendance-dev-faces-delete",
        "arn:aws:lambda:us-east-1:${account_id}:function:attendance-dev-failure"
      ]
    },
    {
      "Sid": "LambdaInvokeConfiguration",
      "Effect": "Allow",
      "Action": [
        "lambda:PutFunctionEventInvokeConfig",
        "lambda:GetFunctionEventInvokeConfig",
        "lambda:DeleteFunctionEventInvokeConfig",
        "lambda:AddPermission",
        "lambda:GetPolicy",
        "lambda:RemovePermission"
      ],
      "Resource": [
        "arn:aws:lambda:us-east-1:${account_id}:function:attendance-dev-employees",
        "arn:aws:lambda:us-east-1:${account_id}:function:attendance-dev-attendance-query",
        "arn:aws:lambda:us-east-1:${account_id}:function:attendance-dev-daily-job",
        "arn:aws:lambda:us-east-1:${account_id}:function:attendance-dev-weekly-job",
        "arn:aws:lambda:us-east-1:${account_id}:function:attendance-dev-reports",
        "arn:aws:lambda:us-east-1:${account_id}:function:attendance-dev-override",
        "arn:aws:lambda:us-east-1:${account_id}:function:attendance-dev-settings",
        "arn:aws:lambda:us-east-1:${account_id}:function:attendance-dev-presign",
        "arn:aws:lambda:us-east-1:${account_id}:function:attendance-dev-result",
        "arn:aws:lambda:us-east-1:${account_id}:function:attendance-dev-recognize",
        "arn:aws:lambda:us-east-1:${account_id}:function:attendance-dev-enroll",
        "arn:aws:lambda:us-east-1:${account_id}:function:attendance-dev-enroll-url",
        "arn:aws:lambda:us-east-1:${account_id}:function:attendance-dev-faces-delete",
        "arn:aws:lambda:us-east-1:${account_id}:function:attendance-dev-failure"
      ]
    },
    {
      "Sid": "LambdaEventSourceMappingCreate",
      "Effect": "Allow",
      "Action": "lambda:CreateEventSourceMapping",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "lambda:FunctionArn": "arn:aws:lambda:us-east-1:${account_id}:function:attendance-dev-failure"
        }
      }
    },
    {
      "Sid": "LambdaEventSourceMappingManage",
      "Effect": "Allow",
      "Action": [
        "lambda:GetEventSourceMapping",
        "lambda:UpdateEventSourceMapping",
        "lambda:DeleteEventSourceMapping"
      ],
      "Resource": "arn:aws:lambda:us-east-1:${account_id}:event-source-mapping:*",
      "Condition": {
        "StringEquals": {
          "lambda:FunctionArn": "arn:aws:lambda:us-east-1:${account_id}:function:attendance-dev-failure"
        }
      }
    },
    {
      "Sid": "LambdaCommonLayer",
      "Effect": "Allow",
      "Action": "lambda:GetLayerVersion",
      "Resource": "arn:aws:lambda:us-east-1:${account_id}:layer:attendance-dev-common:*"
    }
  ]
}
