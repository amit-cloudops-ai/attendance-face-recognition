{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "IamRoleCreate",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole"
      ],
      "Resource": [
        "arn:aws:iam::${account_id}:role/attendance-prod-employees",
        "arn:aws:iam::${account_id}:role/attendance-prod-attendance-query",
        "arn:aws:iam::${account_id}:role/attendance-prod-daily-job",
        "arn:aws:iam::${account_id}:role/attendance-prod-weekly-job",
        "arn:aws:iam::${account_id}:role/attendance-prod-reports",
        "arn:aws:iam::${account_id}:role/attendance-prod-override",
        "arn:aws:iam::${account_id}:role/attendance-prod-settings",
        "arn:aws:iam::${account_id}:role/attendance-prod-presign",
        "arn:aws:iam::${account_id}:role/attendance-prod-result",
        "arn:aws:iam::${account_id}:role/attendance-prod-recognize",
        "arn:aws:iam::${account_id}:role/attendance-prod-enroll",
        "arn:aws:iam::${account_id}:role/attendance-prod-enroll-url",
        "arn:aws:iam::${account_id}:role/attendance-prod-faces-delete",
        "arn:aws:iam::${account_id}:role/attendance-prod-failure"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::${account_id}:policy/attendance-prod-execution-boundary",
          "aws:RequestTag/Project": "attendance",
          "aws:RequestTag/Environment": "prod"
        }
      }
    },
    {
      "Sid": "IamRoleManage",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:DeleteRole",
        "iam:ListRoleTags",
        "iam:TagRole",
        "iam:UntagRole"
      ],
      "Resource": [
        "arn:aws:iam::${account_id}:role/attendance-prod-employees",
        "arn:aws:iam::${account_id}:role/attendance-prod-attendance-query",
        "arn:aws:iam::${account_id}:role/attendance-prod-daily-job",
        "arn:aws:iam::${account_id}:role/attendance-prod-weekly-job",
        "arn:aws:iam::${account_id}:role/attendance-prod-reports",
        "arn:aws:iam::${account_id}:role/attendance-prod-override",
        "arn:aws:iam::${account_id}:role/attendance-prod-settings",
        "arn:aws:iam::${account_id}:role/attendance-prod-presign",
        "arn:aws:iam::${account_id}:role/attendance-prod-result",
        "arn:aws:iam::${account_id}:role/attendance-prod-recognize",
        "arn:aws:iam::${account_id}:role/attendance-prod-enroll",
        "arn:aws:iam::${account_id}:role/attendance-prod-enroll-url",
        "arn:aws:iam::${account_id}:role/attendance-prod-faces-delete",
        "arn:aws:iam::${account_id}:role/attendance-prod-failure"
      ]
    },
    {
      "Sid": "IamInlinePolicies",
      "Effect": "Allow",
      "Action": [
        "iam:PutRolePolicy",
        "iam:GetRolePolicy",
        "iam:DeleteRolePolicy"
      ],
      "Resource": [
        "arn:aws:iam::${account_id}:role/attendance-prod-employees",
        "arn:aws:iam::${account_id}:role/attendance-prod-attendance-query",
        "arn:aws:iam::${account_id}:role/attendance-prod-daily-job",
        "arn:aws:iam::${account_id}:role/attendance-prod-weekly-job",
        "arn:aws:iam::${account_id}:role/attendance-prod-reports",
        "arn:aws:iam::${account_id}:role/attendance-prod-override",
        "arn:aws:iam::${account_id}:role/attendance-prod-settings",
        "arn:aws:iam::${account_id}:role/attendance-prod-presign",
        "arn:aws:iam::${account_id}:role/attendance-prod-result",
        "arn:aws:iam::${account_id}:role/attendance-prod-recognize",
        "arn:aws:iam::${account_id}:role/attendance-prod-enroll",
        "arn:aws:iam::${account_id}:role/attendance-prod-enroll-url",
        "arn:aws:iam::${account_id}:role/attendance-prod-faces-delete",
        "arn:aws:iam::${account_id}:role/attendance-prod-failure"
      ]
    },
    {
      "Sid": "PassRoleToLambda",
      "Effect": "Allow",
      "Action": [
        "iam:PassRole"
      ],
      "Resource": [
        "arn:aws:iam::${account_id}:role/attendance-prod-employees",
        "arn:aws:iam::${account_id}:role/attendance-prod-attendance-query",
        "arn:aws:iam::${account_id}:role/attendance-prod-daily-job",
        "arn:aws:iam::${account_id}:role/attendance-prod-weekly-job",
        "arn:aws:iam::${account_id}:role/attendance-prod-reports",
        "arn:aws:iam::${account_id}:role/attendance-prod-override",
        "arn:aws:iam::${account_id}:role/attendance-prod-settings",
        "arn:aws:iam::${account_id}:role/attendance-prod-presign",
        "arn:aws:iam::${account_id}:role/attendance-prod-result",
        "arn:aws:iam::${account_id}:role/attendance-prod-recognize",
        "arn:aws:iam::${account_id}:role/attendance-prod-enroll",
        "arn:aws:iam::${account_id}:role/attendance-prod-enroll-url",
        "arn:aws:iam::${account_id}:role/attendance-prod-faces-delete",
        "arn:aws:iam::${account_id}:role/attendance-prod-failure"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "lambda.amazonaws.com"
        }
      }
    },
    {
      "Sid": "PassRoleToScheduler",
      "Effect": "Allow",
      "Action": [
        "iam:PassRole"
      ],
      "Resource": [
        "arn:aws:iam::${account_id}:role/attendance-prod-daily-job-scheduler",
        "arn:aws:iam::${account_id}:role/attendance-prod-weekly-job-scheduler"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "scheduler.amazonaws.com"
        }
      }
    },
    {
      "Sid": "IamRoleBoundaryEnforcement",
      "Effect": "Allow",
      "Action": "iam:PutRolePermissionsBoundary",
      "Resource": [
        "arn:aws:iam::${account_id}:role/attendance-prod-employees",
        "arn:aws:iam::${account_id}:role/attendance-prod-attendance-query",
        "arn:aws:iam::${account_id}:role/attendance-prod-daily-job",
        "arn:aws:iam::${account_id}:role/attendance-prod-weekly-job",
        "arn:aws:iam::${account_id}:role/attendance-prod-reports",
        "arn:aws:iam::${account_id}:role/attendance-prod-override",
        "arn:aws:iam::${account_id}:role/attendance-prod-settings",
        "arn:aws:iam::${account_id}:role/attendance-prod-presign",
        "arn:aws:iam::${account_id}:role/attendance-prod-result",
        "arn:aws:iam::${account_id}:role/attendance-prod-recognize",
        "arn:aws:iam::${account_id}:role/attendance-prod-enroll",
        "arn:aws:iam::${account_id}:role/attendance-prod-enroll-url",
        "arn:aws:iam::${account_id}:role/attendance-prod-faces-delete",
        "arn:aws:iam::${account_id}:role/attendance-prod-failure"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PermissionsBoundary": "arn:aws:iam::${account_id}:policy/attendance-prod-execution-boundary"
        }
      }
    }
  ]
}
