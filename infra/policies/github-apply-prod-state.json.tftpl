{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "StateBucketLocation",
      "Effect": "Allow",
      "Action": [
        "s3:GetBucketLocation",
        "s3:GetBucketVersioning"
      ],
      "Resource": "arn:aws:s3:::${state_bucket}"
    },
    {
      "Sid": "ProdStateBucketList",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::${state_bucket}",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "attendance/prod/terraform.tfstate",
            "attendance/prod/terraform.tfstate.tflock"
          ]
        }
      }
    },
    {
      "Sid": "ProdStateObject",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::${state_bucket}/attendance/prod/terraform.tfstate"
    },
    {
      "Sid": "ProdLockfileLifecycle",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::${state_bucket}/attendance/prod/terraform.tfstate.tflock"
    }
  ]
}
