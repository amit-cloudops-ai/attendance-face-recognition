env                         = "prod"
account_id                  = "924422830139"
api_id                      = "a1b2c3d4e5" # Replace with the actual prod API Gateway HTTP API ID.
alert_email                 = "replace-with-your-alert-email@example.com"
execution_role_boundary_arn = "arn:aws:iam::924422830139:policy/attendance-prod-execution-boundary"

# Initial values for the first deployment only. After CloudFront exists,
# replace these with the exact HTTPS site URL and apply the reviewed update.
callback_urls   = ["http://localhost:8000/callback.html"]
logout_urls     = ["http://localhost:8000/"]
allowed_origins = ["http://localhost:8000"]

# Defaults reserve 19 concurrent executions across five Lambda functions.
# Set individual values to null if the account quota cannot support reservations.
lambda_reserved_concurrency = {
  recognize = 10
  enroll    = 5
  failure   = 2
  daily     = 1
  weekly    = 1
}
